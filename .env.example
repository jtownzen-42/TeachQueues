# Copy to .env.local for local dev (never commit real values).
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_REDIRECT_URI=https://localhost:3000/api/auth/callback
# Optional override; default: account:read posts:read posts:write offline_access
BUFFER_SCOPES=
DATABASE_URL=
# 32+ random chars for the iron-session cookie: openssl rand -base64 48
SESSION_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENC_KEY=
BLOB_READ_WRITE_TOKEN=
# true = every Buffer post is created with saveToDraft: true (never publishes)
TEST_MODE=true
